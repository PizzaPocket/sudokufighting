{
  "name": "@sudoku-fighting/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "build:native": "VITE_NATIVE=true VITE_AUTH_REDIRECT_URL=sudokufighting://auth/callback tsc && VITE_NATIVE=true VITE_AUTH_REDIRECT_URL=sudokufighting://auth/callback vite build",
    "cap:sync": "pnpm build:native && cap sync",
    "cap:ios": "pnpm build:native && cap sync ios && cap open ios",
    "cap:android": "pnpm build:native && cap sync android && cap open android"
  },
  "dependencies": {
    "@capacitor-community/apple-sign-in": "^7.1.0",
    "@capacitor/android": "^8.3.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/cli": "^8.3.1",
    "@capacitor/core": "^8.3.1",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.3.1",
    "@sudoku-fighting/shared": "workspace:*",
    "@supabase/supabase-js": "^2.103.0",
    "bad-words": "^4.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@types/bad-words": "^3.0.3",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.4.0",
    "vite": "^5.4.0"
  }
}
