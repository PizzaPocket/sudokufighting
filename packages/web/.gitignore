# tsc emit dir — never emits into src, so ghost .js files can't appear there
.tsc-out/

# Capacitor web asset copies — regenerated by `cap sync`, don't bloat the repo
ios/App/App/public/
android/app/src/main/assets/public/

# Capacitor build artifacts
android/.gradle/
android/app/build/
ios/App/Pods/
ios/App/App.xcworkspace/xcuserdata/
