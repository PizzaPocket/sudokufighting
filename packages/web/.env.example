# Supabase — create a project at https://supabase.com, then copy these from
# Project Settings → API.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# OAuth redirect URL — where Supabase sends the user after Google/Apple sign-in.
# Development: http://localhost:5173
# Production:  https://sudokufighting.com
# Native (Capacitor): sudokufighting://auth/callback
VITE_AUTH_REDIRECT_URL=http://localhost:5173

# Set to true when building for Capacitor (iOS/Android).
# Forces WebSocket to point to production backend (localhost unavailable on device).
# VITE_NATIVE=true

# Backend base URL for HTTP API calls (account deletion, etc.).
# Leave unset for local dev — Vite proxy forwards /account to localhost:8080.
# Required for Capacitor native builds where the Vite proxy is unavailable.
# VITE_BACKEND_URL=https://sudoku-fighting-backend.fly.dev

# Add both values above to your Supabase dashboard under:
# Authentication → URL Configuration → Redirect URLs
