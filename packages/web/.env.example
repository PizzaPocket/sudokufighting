# Supabase — create a project at https://supabase.com, then copy these from
# Project Settings → API.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# OAuth redirect URL — where Supabase sends the user after Google/Apple sign-in.
# Development: http://localhost:5173
# Production:  https://sudokufighting.com
# Capacitor (phase 3): sudokufighting://auth/callback
VITE_AUTH_REDIRECT_URL=http://localhost:5173

# Add both values above to your Supabase dashboard under:
# Authentication → URL Configuration → Redirect URLs
