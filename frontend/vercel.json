{
  "buildCommand": "echo \"window.WS_URL='$WS_URL'\" > js/config.js",
  "outputDirectory": ".",
  "redirects": [
    { "source": "/favicon.ico", "destination": "/assets/favicons/favicon.ico", "permanent": true }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/favicons/site.webmanifest",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
